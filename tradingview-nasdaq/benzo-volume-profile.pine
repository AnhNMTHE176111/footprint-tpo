//@version=6
indicator("Benzo Volume Profile", "Benzo VP", overlay = true, behind_chart = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_polylines_count = 100)

// Port of benzo-volume-profile.script.js + benzo-volume-profile.inputs.json.
// Week / Day volume profiles (or both), HVN / LVN zones and an anchored VWAP with three σ bands.
// Profiles / zones are built from lower-timeframe bars (Profile Data Timeframe) and the VWAP from
// 1m bars, so every intraday chart timeframe draws the same levels. Intraday charts only.

// =====================================================================================
//  INPUTS  (same ids / defaults as the JSON)
// =====================================================================================
grpP            = "Profile"
hideCandles     = input.bool(false, "Hide Candles (show only the profile)", group = grpP)
showWeekProfile = input.bool(true, "Show Week Profile", group = grpP)
showDayProfile  = input.bool(true, "Show Day Profile", group = grpP)
profileRes      = input.string("1m", "Profile Data Timeframe", options = ["1m", "5m", "15m", "30m"], group = grpP)
profileRows     = input.int(200, "Rows per Profile", minval = 8, maxval = 200, step = 1, group = grpP)
valueArea       = input.float(70, "Value Area %", minval = 50, maxval = 95, step = 1, group = grpP)
maxSessions     = input.int(5, "Historical Sessions to Keep (weeks / days per profile)", minval = 1, maxval = 10, step = 1, group = grpP)
widthPct        = input.float(1.0, "Profile Width (% of session)", minval = 0.05, maxval = 1.0, step = 0.02, group = grpP)
maxWidthBar     = input.int(90, "Max Profile Width (bars)", minval = 10, maxval = 300, step = 1, group = grpP)
showLive        = input.bool(true, "Show Developing (current) Profile", group = grpP)
showWeekVA      = input.bool(true, "Week VAH / VAL (dashed)", group = grpP)
showDayVA       = input.bool(true, "Day VAH / VAL (dashed)", group = grpP)
rowNumbersOn    = input.string("Day", "Volume Number on Each Row (developing profile)", options = ["Off", "Day", "Week", "Both"], group = grpP, tooltip = "Hover a number for sell / buy split and the row's price range. Pine allows 500 labels, so only the developing profile gets numbers; lower Rows per Profile if they overlap.")
rowNumberColor  = input.color(#d1d4dc, "Row Number Color", group = grpP)
rowNumberMax    = input.int(70, "Hide Row Numbers Above (rows on screen)", minval = 10, maxval = 400, step = 5, group = grpP, tooltip = "Rows on screen = visible price range / row height. Zoomed out past this, the numbers are hidden; zooming in makes them bigger.")
vaBoost         = input.float(1.18, "Value Area Emphasis", minval = 1.0, maxval = 2.0, step = 0.02, group = grpP)

grpV       = "VWAP"
showVWAP   = input.bool(true, "Session VWAP", group = grpV)
vwapSrc    = input.string("hlc3", "VWAP Source", options = ["hlc3", "close", "open", "high", "low", "hl2", "ohlc4", "hlcc4"], group = grpV)
vwapAnchor = input.string("1D", "VWAP Anchor", options = ["1h", "4h", "1D", "1W", "1M"], group = grpV)
vwapKeep   = input.int(5, "VWAP Periods to Keep", minval = 1, maxval = 20, step = 1, group = grpV)
showBand1  = input.bool(true, "Band #1", group = grpV, inline = "b1")
bandMult1  = input.float(1.0, "Multiplier (σ)", minval = 0.1, maxval = 5.0, step = 0.1, group = grpV, inline = "b1")
showBand2  = input.bool(false, "Band #2", group = grpV, inline = "b2")
bandMult2  = input.float(2.0, "Multiplier (σ)", minval = 0.1, maxval = 5.0, step = 0.1, group = grpV, inline = "b2")
showBand3  = input.bool(false, "Band #3", group = grpV, inline = "b3")
bandMult3  = input.float(3.0, "Multiplier (σ)", minval = 0.1, maxval = 5.0, step = 0.1, group = grpV, inline = "b3")

grpZ    = "HVN / LVN"
showHVN = input.bool(true, "HVN Zones", group = grpZ)
showLVN = input.bool(true, "LVN Zones", group = grpZ)

grpS           = "Style"
colBuy         = input.color(#90bff9, "Week Profile Buy (up) Volume Color", group = grpS)
colSell        = input.color(#b39ddb, "Week Profile Sell (down) Volume Color", group = grpS)
colDayBuy      = input.color(#c9a43c, "Day Profile Buy (up) Volume Color", group = grpS)
colDaySell     = input.color(#2f5fd8, "Day Profile Sell (down) Volume Color", group = grpS)
colPOC         = input.color(#5b6472, "POC Color", group = grpS)
colWeekVA      = input.color(#4a90e2, "Week VAH / VAL Color", group = grpS)
colDayVA       = input.color(#c9a43c, "Day VAH / VAL Color", group = grpS)
colVWAP        = input.color(#ab47bc, "VWAP Line Color", group = grpS)
vwapWidth      = input.int(2, "VWAP Line Width", minval = 1, maxval = 4, step = 1, group = grpS)
bandLine1      = input.color(#ab47bca6, "Band #1 Line Color", group = grpS)
bandFill1      = input.color(#ab47bc1a, "Band #1 Zone Fill", group = grpS)
bandLine2      = input.color(#ab47bc80, "Band #2 Line Color", group = grpS)
bandFill2      = input.color(#ab47bc12, "Band #2 Zone Fill", group = grpS)
bandLine3      = input.color(#ab47bc59, "Band #3 Line Color", group = grpS)
bandFill3      = input.color(#ab47bc0d, "Band #3 Zone Fill", group = grpS)
hvnBuyColor    = input.color(#26a69a, "HVN Buy Zone Color", group = grpS)
hvnSellColor   = input.color(#ef5350, "HVN Sell Zone Color", group = grpS)
hvnInsideColor = input.color(#9e9e9e, "HVN / LVN Color (price inside zone)", group = grpS)
lvnBuyColor    = input.color(#29b6f6, "LVN Buy Zone Color", group = grpS)
lvnSellColor   = input.color(#ffa726, "LVN Sell Zone Color", group = grpS)

// =====================================================================================
//  CONSTANTS
// =====================================================================================
HOUR_MS     = 3600000
// Each side of a profile is one simple polygon at T_BASE, plus a second polygon over its busy rows
// (volume >= HOT_SHARE of the POC) at T_HOT. TradingView fills polylines with long connecting or
// retraced edges as big wedges, so every polygon stays local to one profile side.
T_BASE      = 62
T_HOT       = 25
HOT_SHARE   = 0.5
TRANSPARENT = color.new(color.black, 100)
barMs       = timeframe.in_seconds() * 1000
// Pine keeps only 100 polylines (oldest deleted first, i.e. the VWAP history): the second, busy-row
// layer is drawn only when every profile and VWAP period fits.
nProfMax    = (showWeekProfile ? maxSessions + 1 : 0) + (showDayProfile ? maxSessions + 1 : 0)
nBands      = (showBand1 ? 1 : 0) + (showBand2 ? 1 : 0) + (showBand3 ? 1 : 0)
vwPolyMax   = showVWAP ? (vwapKeep + 1) * (1 + 4 * nBands) : 0
useHotLayer = nProfMax * 4 + vwPolyMax <= 100
// HVN / LVN zones come from the week profile while it is shown, otherwise from the day profile.
isDay       = showDayProfile and not showWeekProfile

// HVN (volume cluster) detection, sized by `unit` (mean 1h range) so it adapts to any symbol.
HVN_ROW_FRAC     = 0.25   // weekly row height = 0.25 x mean 1h range
HVN_DAY_ROW_FRAC = 0.15
HVN_MIN_ROWS     = 100
HVN_DAY_MIN_ROWS = 40
HVN_MAX_ROWS     = 400
HVN_SIGMA        = 1.5    // Gaussian smoothing, in rows
HVN_PROM         = 0.3    // a peak dips >= 30% to the valley on each side
HVN_EDGE         = 0.7    // zone = rows holding >= 70% of the peak
HVN_MIN_VOL      = 0.12
HVN_MIN_TIME     = 0.05
HVN_SHAPE_LO     = 0.15
HVN_SHAPE_HI     = 0.85
HVN_BODY         = 0.3
HVN_PEAKED       = 1.25
HVN_CORE_BODY    = 0.7
HVN_TAPER        = 0.25
HVN_PEAK_POC     = 0.35
HVN_NEAR_GAP     = 0.5
LVN_MAX_VALLEY   = 0.5
LVN_EDGE         = 0.25
LVN_SIDE_SHARE   = 0.08
LVN_SIDE_PEAK    = 0.25
LVN_MIN_W        = 0.1

// =====================================================================================
//  DATA
// =====================================================================================
f_resTf(string s) =>
    switch s
        "5m"  => "5"
        "15m" => "15"
        "30m" => "30"
        => "1"

f_anchorTf(string s) =>
    switch s
        "1h" => "60"
        "4h" => "240"
        "1W" => "W"
        "1M" => "M"
        => "D"

f_src() =>
    switch vwapSrc
        "close" => close
        "open"  => open
        "high"  => high
        "low"   => low
        "hl2"   => hl2
        "ohlc4" => ohlc4
        "hlcc4" => hlcc4
        => hlc3

// Profile data: bars of the chosen timeframe inside each chart bar. A timeframe above the chart's
// is not allowed by request.security_lower_tf, so the chart bars are used then.
resTf  = f_resTf(profileRes)
dataTf = timeframe.in_seconds(resTf) < timeframe.in_seconds() ? resTf : timeframe.period
[xH, xL, xV, xO, xC, xT] = request.security_lower_tf(syminfo.tickerid, dataTf, [high, low, volume, open, close, time])

// Old chart bars beyond the intrabar history get empty arrays: fall back to the chart bar.
array<float> dH = xH
array<float> dL = xL
array<float> dV = xV
array<float> dO = xO
array<float> dC = xC
array<int>   dT = xT
if array.size(xV) == 0
    dH := array.from(high)
    dL := array.from(low)
    dV := array.from(volume)
    dO := array.from(open)
    dC := array.from(close)
    dT := array.from(time)

// VWAP data: 1m bars, with the anchor reset evaluated on the 1m bars themselves.
anchorTf = f_anchorTf(vwapAnchor)
vwTf     = timeframe.in_seconds() >= 60 ? "1" : timeframe.period
[vPV, vV, vP2V, vNew] = request.security_lower_tf(syminfo.tickerid, vwTf, [f_src() * volume, volume, f_src() * f_src() * volume, timeframe.change(anchorTf)])
chartAnc = timeframe.change(anchorTf)
newDay   = timeframe.change("D")
newWeek  = timeframe.change("W")

// Base buffer: confirmed profile-resolution bars of the sessions still needed (current + previous
// week, or the last maxSessions days + today). bBase = absolute index of element 0.
var array<float> bH = array.new<float>()
var array<float> bL = array.new<float>()
var array<float> bV = array.new<float>()
var array<float> bO = array.new<float>()
var array<float> bC = array.new<float>()
var array<int>   bT = array.new<int>()
var int bBase = 0

var int wkStart     = na   // absolute base index where the current week starts
var int wkT0        = na   // chart time of the week's first bar
var int wkLastT     = na
var int wkBars      = 0    // chart bars in the week (drives the profile width)
var int wkPrevStart = na
var int wkPrevT0    = na
var int dyStart     = na
var int dyT0        = na
var int dyLastT     = na
var int dyBars      = 0
var array<int> dayStarts = array.new<int>()
var array<int> dayT0s    = array.new<int>()

// =====================================================================================
//  TYPES
// =====================================================================================
type Prof
    int         x1
    float       bot
    float       rh
    array<int>  sellW
    array<int>  buyW
    array<bool> hot
    array<float> vol
    array<float> sellVol
    box  pocBox
    line pocLine
    line vahLine
    line valLine

type NodeProf
    float        bot
    float        rowSize
    int          rows
    array<float> vr
    array<float> sm
    float        total
    int          pocRow
    array<int>   peaks
    array<int>   cuts

type Zone
    float lo
    float hi
    float vol        = 0.0
    float volShare   = 0.0
    float shape      = 0.5
    bool  isPoc      = false
    float timeShare  = 0.0
    float peakOfPoc  = 0.0
    float peakedness = 0.0
    float coreOfBody = 0.0
    float taper      = 0.0
    int   peakRow    = 0
    float score      = 0.0
    int   fromT      = 0
    int   count      = 0
    array<int> tags

type Group
    float hi
    Zone  best
    array<int> days

method del(Prof this) =>
    box.delete(this.pocBox)
    line.delete(this.pocLine)
    line.delete(this.vahLine)
    line.delete(this.valLine)

// =====================================================================================
//  PROFILE
// =====================================================================================
f_hiLo(array<float> H, array<float> L, int a, int b) =>
    float top = na
    float bot = na
    if b > a
        for k = a to b - 1
            h = H.get(k)
            l = L.get(k)
            if not na(h)
                top := na(top) ? h : math.max(top, h)
            if not na(l)
                bot := na(bot) ? l : math.min(bot, l)
    [top, bot]

// Spreads each bar's volume evenly over the rows its high-low range touches.
f_bin(array<float> H, array<float> L, array<float> V, array<float> O, array<float> C, int a, int b, array<float> vr, array<float> dr, float bot, float rh) =>
    rows = vr.size()
    if b > a
        for k = a to b - 1
            v = V.get(k)
            if not na(v) and v > 0
                // Clamp into [0, rows-1]: a bar touching the session top maps to bin == rows.
                rB = math.min(rows - 1, math.max(0, int(math.floor((L.get(k) - bot) / rh))))
                rT = math.min(rows - 1, math.max(0, int(math.floor((H.get(k) - bot) / rh))))
                ve = v / (rT - rB + 1)
                isDown = C.get(k) < O.get(k)
                for r = rB to rT
                    vr.set(r, vr.get(r) + ve)
                    if isDown
                        dr.set(r, dr.get(r) + ve)
    0

// Value area grown outward from the POC one row at a time (higher side wins ties).
f_valueArea(array<float> vr) =>
    rows   = vr.size()
    pIdx   = vr.indexof(vr.max())
    target = vr.sum() * valueArea / 100.0
    vaVol  = vr.get(pIdx)
    up = pIdx
    dn = pIdx
    while vaVol < target and (up < rows - 1 or dn > 0)
        uV = up < rows - 1 ? vr.get(up + 1) : -1.0
        dV = dn > 0 ? vr.get(dn - 1) : -1.0
        if uV >= dV
            up += 1
            vaVol += uV
        else
            dn -= 1
            vaVol += dV
    [pIdx, up, dn]

// Profile of buffer bars [a, b) (plus the forming chart bar's data when addX). Row widths are
// counted in chart bars, then converted to ms.
f_profile(int a, int b, bool addX, int nBars, array<int> sellW, array<int> buyW, array<bool> hot, array<float> vol, array<float> sellVol) =>
    [t1, b1] = f_hiLo(bH, bL, a, b)
    float top = t1
    float bot = b1
    if addX
        [t2, b2] = f_hiLo(dH, dL, 0, dH.size())
        top := na(top) ? t2 : na(t2) ? top : math.max(top, t2)
        bot := na(bot) ? b2 : na(b2) ? bot : math.min(bot, b2)
    float poc    = na
    float pocTop = na
    float pocBot = na
    float vah    = na
    float val    = na
    float rh     = na
    if not na(top) and not na(bot)
        rows = profileRows
        rh  := (top - bot) / rows
        vr   = array.new<float>(rows, 0.0)
        dr   = array.new<float>(rows, 0.0)
        if rh > 0
            f_bin(bH, bL, bV, bO, bC, a, b, vr, dr, bot, rh)
            if addX
                f_bin(dH, dL, dV, dO, dC, 0, dV.size(), vr, dr, bot, rh)
        [pIdx, up, dn] = f_valueArea(vr)
        maxV = vr.get(pIdx)
        wMax = math.min(maxWidthBar, math.max(3, int(nBars * widthPct)))
        if maxV > 0 and rh > 0
            for r = 0 to rows - 1
                tv    = vr.get(r)
                int w = 0
                int dW = 0
                bool isHot = false
                if tv > 0
                    w     := math.max(1, int(tv / maxV * wMax))
                    dW    := int(dr.get(r) / tv * w)
                    inVA   = r >= dn and r <= up
                    isHot := tv / maxV * (inVA ? vaBoost : 1.0) >= HOT_SHARE
                sellW.push(dW * barMs)
                buyW.push((w - dW) * barMs)
                hot.push(isHot)
                vol.push(tv)
                sellVol.push(dr.get(r))
        poc    := bot + (pIdx + 0.5) * rh
        pocTop := poc + rh * 0.5
        pocBot := poc - rh * 0.5
        vah    := bot + (up + 1) * rh
        val    := bot + dn * rh
    [poc, pocTop, pocBot, vah, val, bot, rh]

// One profile: its rows (drawn later as polylines) plus POC box / line and dashed VAH / VAL.
f_makeProf(int a, int b, bool addX, int x1, int x2, int nBars, bool showVA, color vaCol) =>
    sellW = array.new<int>()
    buyW  = array.new<int>()
    hot   = array.new<bool>()
    vol   = array.new<float>()
    sellV = array.new<float>()
    [poc, pocTop, pocBot, vah, val, pBot, rh] = f_profile(a, b, addX, nBars, sellW, buyW, hot, vol, sellV)
    Prof p = Prof.new(x1, pBot, rh, sellW, buyW, hot, vol, sellV, na, na, na, na)
    if not na(poc)
        p.pocBox  := box.new(x1, pocTop, x2, pocBot, xloc = xloc.bar_time, border_width = 0, border_color = TRANSPARENT, bgcolor = color.new(colPOC, 62))
        p.pocLine := line.new(x1, poc, x2, poc, xloc = xloc.bar_time, color = color.new(colPOC, 15), width = 4)
        if showVA
            p.vahLine := line.new(x1, vah, x2, vah, xloc = xloc.bar_time, color = vaCol, style = line.style_dashed, width = 1)
            p.valLine := line.new(x1, val, x2, val, xloc = xloc.bar_time, color = vaCol, style = line.style_dashed, width = 1)
    p

f_clearPolys(array<polyline> a) =>
    for p in a
        polyline.delete(p)
    a.clear()

// One side of a profile as a staircase polygon: up the outer edge, back down the inner edge. Rows
// left out of the layer get zero width, so the outline never crosses itself.
f_sidePoints(Prof p, bool isSell, bool hotOnly) =>
    pts = array.new<chart.point>()
    n   = p.sellW.size()
    if n > 0
        for r = 0 to n - 1
            L = isSell ? p.x1 : p.x1 + p.sellW.get(r)
            R = hotOnly and not p.hot.get(r) ? L : L + (isSell ? p.sellW.get(r) : p.buyW.get(r))
            pts.push(chart.point.from_time(R, p.bot + r * p.rh))
            pts.push(chart.point.from_time(R, p.bot + (r + 1) * p.rh))
        for r = n - 1 to 0
            L = isSell ? p.x1 : p.x1 + p.sellW.get(r)
            pts.push(chart.point.from_time(L, p.bot + (r + 1) * p.rh))
            pts.push(chart.point.from_time(L, p.bot + r * p.rh))
    pts

f_sidePoly(array<polyline> pool, Prof p, bool isSell, bool hotOnly, color col) =>
    pts = f_sidePoints(p, isSell, hotOnly)
    if pts.size() > 2
        pool.push(polyline.new(pts, curved = false, closed = true, xloc = xloc.bar_time, line_color = TRANSPARENT, fill_color = color.new(col, hotOnly ? T_HOT : T_BASE)))

f_drawProf(Prof p, array<polyline> pool, color buyC, color sellC) =>
    hasHot = useHotLayer and p.hot.includes(true)
    f_sidePoly(pool, p, true, false, sellC)
    f_sidePoly(pool, p, false, false, buyC)
    if hasHot
        f_sidePoly(pool, p, true, true, sellC)
        f_sidePoly(pool, p, false, true, buyC)

// Total volume of each row in one column at the profile's start; the tooltip splits it into sell / buy.
// Pine cannot read the chart's zoom, so the visible price range is taken from the visible candles
// plus the profile (as auto-scale would show it). Manual price-scale zoom is not seen.
f_rowNumberSize(Prof p, float visHi, float visLo) =>
    n   = p.vol.size()
    hi  = math.max(nz(visHi, p.bot + n * p.rh), p.bot + n * p.rh)
    lo  = math.min(nz(visLo, p.bot), p.bot)
    rowsOnScreen = p.rh > 0 ? (hi - lo) / p.rh : na
    string sz = na
    if not na(rowsOnScreen) and rowsOnScreen <= rowNumberMax
        sz := rowsOnScreen <= 15 ? size.large : rowsOnScreen <= 25 ? size.normal : rowsOnScreen <= 40 ? size.small : size.tiny
    sz

f_rowNumbers(Prof p, array<label> pool, float visHi, float visLo) =>
    n  = p.vol.size()
    sz = f_rowNumberSize(p, visHi, visLo)
    if n > 0 and not na(sz)
        for r = 0 to n - 1
            v = p.vol.get(r)
            if v > 0
                sv  = p.sellVol.get(r)
                yB  = p.bot + r * p.rh
                tip = str.tostring(yB, format.mintick) + " – " + str.tostring(yB + p.rh, format.mintick) + "\nTotal: " + str.tostring(v, format.volume) + "\nSell: " + str.tostring(sv, format.volume) + "\nBuy: " + str.tostring(v - sv, format.volume)
                pool.push(label.new(p.x1, yB + p.rh * 0.5, str.tostring(v, format.volume), xloc = xloc.bar_time, style = label.style_label_left, color = TRANSPARENT, textcolor = rowNumberColor, size = sz, tooltip = tip))

f_drawProfs(array<Prof> ps, array<polyline> pool, color buyC, color sellC) =>
    for p in ps
        f_drawProf(p, pool, buyC, sellC)

// =====================================================================================
//  HVN / LVN
// =====================================================================================
f_hourUnit(int a, int b) =>
    float sum = 0.0
    int   cnt = 0
    int   key = -1
    float hi  = na
    float lo  = na
    if b > a
        for k = a to b - 1
            kk = int(math.floor(bT.get(k) / float(HOUR_MS)))
            if kk != key
                if not na(hi) and hi > lo
                    sum += hi - lo
                    cnt += 1
                key := kk
                hi := na
                lo := na
            hi := na(hi) ? bH.get(k) : math.max(hi, bH.get(k))
            lo := na(lo) ? bL.get(k) : math.min(lo, bL.get(k))
    if not na(hi) and hi > lo
        sum += hi - lo
        cnt += 1
    cnt > 0 ? sum / cnt : 0.0

f_smooth(array<float> vr, float sigma) =>
    rows   = vr.size()
    radius = math.max(1, int(math.ceil(sigma * 3)))
    w = array.new<float>(radius * 2 + 1, 0.0)
    for k = -radius to radius
        w.set(k + radius, math.exp(-(k * k) / (2 * sigma * sigma)))
    sm = array.new<float>(rows, 0.0)
    for r = 0 to rows - 1
        acc = 0.0
        ws  = 0.0
        for k = -radius to radius
            j = r + k
            if j >= 0 and j < rows
                acc += vr.get(j) * w.get(k + radius)
                ws  += w.get(k + radius)
        sm.set(r, acc / ws)
    sm

// Profile of buffer bars [a, b) on a fixed price grid, smoothed, with its cluster peaks and the
// lowest row (the cut) between each pair of neighbouring peaks.
f_nodeProfile(int a, int b, float unit, float rowFrac, int minRows) =>
    NodeProf P = na
    if b - a >= 30 and unit > 0
        [top, bot0] = f_hiLo(bH, bL, a, b)
        if top > bot0
            float rowSize = math.min(unit * rowFrac, (top - bot0) / minRows)
            int rows = int(math.ceil((top - bot0) / rowSize))
            if rows > HVN_MAX_ROWS
                rows    := HVN_MAX_ROWS
                rowSize := (top - bot0) / rows
            // Rows sit on a fixed price grid, so a new low does not shift every row.
            bot = math.floor(bot0 / rowSize) * rowSize
            rows := int(math.ceil((top - bot) / rowSize))
            if rows >= 8
                vr = array.new<float>(rows, 0.0)
                total = 0.0
                for k = a to b - 1
                    vol = bV.get(k)
                    if not na(vol) and vol > 0
                        rB = math.min(rows - 1, math.max(0, int(math.floor((bL.get(k) - bot) / rowSize))))
                        rT = math.min(rows - 1, math.max(0, int(math.floor((bH.get(k) - bot) / rowSize))))
                        ve = vol / (rT - rB + 1)
                        for r = rB to rT
                            vr.set(r, vr.get(r) + ve)
                        total += vol
                if total > 0
                    sm = f_smooth(vr, HVN_SIGMA)
                    pocRow = 0
                    for r = 1 to rows - 1
                        if sm.get(r) > sm.get(pocRow)
                            pocRow := r
                    // Cluster peaks: local maxima with a real dip (LVN) on both sides.
                    peaks = array.new<int>()
                    for r = 0 to rows - 1
                        p = sm.get(r)
                        isMax = not (r > 0 and not (p > sm.get(r - 1))) and not (r < rows - 1 and sm.get(r + 1) > p)
                        if isMax
                            lMin = p
                            j = r - 1
                            while j >= 0 and sm.get(j) <= p
                                lMin := math.min(lMin, sm.get(j))
                                j -= 1
                            rMin = p
                            j := r + 1
                            while j < rows and sm.get(j) <= p
                                rMin := math.min(rMin, sm.get(j))
                                j += 1
                            if r == pocRow or p - math.max(lMin, rMin) >= HVN_PROM * p
                                peaks.push(r)
                    cuts = array.from(0)
                    if peaks.size() > 1
                        for i = 1 to peaks.size() - 1
                            m = peaks.get(i - 1)
                            for j = peaks.get(i - 1) to peaks.get(i)
                                if sm.get(j) < sm.get(m)
                                    m := j
                            cuts.push(m)
                    cuts.push(rows - 1)
                    P := NodeProf.new(bot, rowSize, rows, vr, sm, total, pocRow, peaks, cuts)
    P

// Every volume cluster of the window, with its dense core and the measures that tell a finished
// D-shaped auction from a flat block or a ramp.
f_clusters(NodeProf P, int a, int b) =>
    cands = array.new<Zone>()
    for [i, r] in P.peaks
        s0 = P.cuts.get(i)
        s1 = P.cuts.get(i + 1)
        segVol = 0.0
        below  = 0.0
        for j = s0 to s1
            segVol += P.vr.get(j)
            if j < r
                below += P.vr.get(j)
        p   = P.sm.get(r)
        thr = p * HVN_EDGE
        ca = r
        while ca - 1 >= s0 and P.sm.get(ca - 1) >= thr
            ca -= 1
        cb = r
        while cb + 1 <= s1 and P.sm.get(cb + 1) >= thr
            cb += 1
        ba = r
        while ba - 1 >= s0 and P.sm.get(ba - 1) >= p * HVN_BODY
            ba -= 1
        bb = r
        while bb + 1 <= s1 and P.sm.get(bb + 1) >= p * HVN_BODY
            bb += 1
        bodySum  = 0.0
        coreRows = 0
        for j = ba to bb
            bodySum += P.sm.get(j)
            if P.sm.get(j) >= thr
                coreRows += 1
        bodyRows = bb - ba + 1
        z = Zone.new(lo = P.bot + ca * P.rowSize, hi = P.bot + (cb + 1) * P.rowSize, peakRow = r)
        z.vol        := segVol
        z.volShare   := segVol / P.total
        z.shape      := segVol > 0 ? below / segVol : 0.5
        z.isPoc      := r == P.pocRow
        z.peakOfPoc  := p / P.sm.get(P.pocRow)
        z.peakedness := p / (bodySum / bodyRows)
        z.coreOfBody := float(coreRows) / bodyRows
        z.taper      := float(math.min(r - ba, bb - r)) / math.max(1, r - ba, bb - r)
        cands.push(z)
    // Time accepted inside each core (share of the window's bars that traded there).
    bars = b - a
    for k = a to b - 1
        for z in cands
            if bL.get(k) <= z.hi and bH.get(k) >= z.lo
                z.timeShare += 1.0 / bars
    for z in cands
        z.score := z.volShare + z.timeShare
    cands

f_isDShaped(Zone z) =>
    z.shape >= HVN_SHAPE_LO and z.shape <= HVN_SHAPE_HI and z.peakedness >= HVN_PEAKED and z.coreOfBody <= HVN_CORE_BODY and z.taper >= HVN_TAPER

// HVN: a well-formed auction. The POC cluster is exempt from the size tests but must be D-shaped.
f_isHvn(Zone z) =>
    f_isDShaped(z) and (z.isPoc or (z.volShare >= HVN_MIN_VOL and z.timeShare >= HVN_MIN_TIME and z.peakOfPoc >= HVN_PEAK_POC))

f_isLvnSide(Zone z) =>
    z.volShare >= LVN_SIDE_SHARE and z.peakOfPoc >= LVN_SIDE_PEAK

// LVN: the deep valley between two neighbouring real clusters; the zone is its thinnest part.
f_lvnOf(NodeProf P, array<Zone> clusters) =>
    out = array.new<Zone>()
    if clusters.size() > 1
        for i = 1 to clusters.size() - 1
            zl = clusters.get(i - 1)
            zr = clusters.get(i)
            if f_isLvnSide(zl) and f_isLvnSide(zr)
                m   = P.cuts.get(i)
                peakLow = math.min(P.sm.get(zl.peakRow), P.sm.get(zr.peakRow))
                v   = P.sm.get(m)
                if v <= LVN_MAX_VALLEY * peakLow
                    thr = v + LVN_EDGE * (peakLow - v)
                    la = m
                    while la - 1 > zl.peakRow and P.sm.get(la - 1) <= thr
                        la -= 1
                    lb = m
                    while lb + 1 < zr.peakRow and P.sm.get(lb + 1) <= thr
                        lb += 1
                    out.push(Zone.new(lo = P.bot + la * P.rowSize, hi = P.bot + (lb + 1) * P.rowSize))
    out

f_nodes(int a, int b, float unit, float rowFrac, int minRows) =>
    hv = array.new<Zone>()
    lv = array.new<Zone>()
    co = array.new<Zone>()
    P = f_nodeProfile(a, b, unit, rowFrac, minRows)
    if not na(P)
        cl = f_clusters(P, a, b)
        for z in cl
            if f_isHvn(z)
                hv.push(z)
            if z.peakOfPoc >= HVN_PEAK_POC
                co.push(z)
        lv := f_lvnOf(P, cl)
    [hv, lv, co]

f_tag(array<Zone> zs, int t) =>
    out = array.new<Zone>()
    for z in zs
        c = z.copy()
        c.fromT := t
        out.push(c)
    out

f_sortByLo(array<Zone> zs) =>
    out = array.new<Zone>()
    if zs.size() > 0
        los = array.new<float>()
        for z in zs
            los.push(z.lo)
        for i in array.sort_indices(los, order.ascending)
            out.push(zs.get(i))
    out

// Overlapping zones (this week / last week) merge into one; zones packed close keep the bigger.
f_mergeHvn(array<Zone> zones, float unit) =>
    out = array.new<Zone>()
    for z in f_sortByLo(zones)
        if out.size() > 0
            last = out.last()
            if z.lo <= last.hi
                last.hi    := math.max(last.hi, z.hi)
                last.vol   := math.max(last.vol, z.vol)
                last.fromT := math.min(last.fromT, z.fromT)
                last.isPoc := last.isPoc or z.isPoc
            else if z.lo - last.hi < HVN_NEAR_GAP * unit
                if z.vol > last.vol
                    out.set(out.size() - 1, z.copy())
            else
                out.push(z.copy())
        else
            out.push(z.copy())
    out

// Daily clusters from several days: overlapping ones are one area, which keeps its most convincing
// zone, tagged with how many days built a cluster there. Close areas keep the stronger one.
f_pickReputable(array<Zone> zones, float unit) =>
    groups = array.new<Group>()
    for z in f_sortByLo(zones)
        if groups.size() > 0 and z.lo <= groups.last().hi
            g = groups.last()
            g.hi := math.max(g.hi, z.hi)
            if not g.days.includes(z.fromT)
                g.days.push(z.fromT)
            if z.score > g.best.score
                g.best := z
        else
            groups.push(Group.new(z.hi, z, array.from(z.fromT)))
    out = array.new<Zone>()
    for g in groups
        z = g.best.copy()
        z.count := g.days.size()
        if out.size() > 0 and z.lo - out.last().hi < HVN_NEAR_GAP * unit
            last = out.last()
            if z.score + 0.05 * z.count > last.score + 0.05 * last.count
                out.set(out.size() - 1, z)
        else
            out.push(z)
    out

// Zone trimmed where a blocker overlaps its edge. A blocker inside it (splitting it) removes it;
// so are slivers thinner than minW.
f_clip(Zone z, array<Zone> blockers, float minW) =>
    los  = array.from(z.lo)
    his  = array.from(z.hi)
    dead = false
    for bl in blockers
        if not dead
            nlo = array.new<float>()
            nhi = array.new<float>()
            for [i, lo] in los
                hi = his.get(i)
                if bl.hi <= lo or bl.lo >= hi
                    nlo.push(lo)
                    nhi.push(hi)
                else
                    if bl.lo > lo
                        nlo.push(lo)
                        nhi.push(bl.lo)
                    if bl.hi < hi
                        nlo.push(bl.hi)
                        nhi.push(hi)
            if nlo.size() > los.size()
                dead := true
            los := nlo
            his := nhi
    out = array.new<Zone>()
    if not dead
        for [i, lo] in los
            if his.get(i) - lo >= minW
                c = z.copy()
                c.lo := lo
                c.hi := his.get(i)
                out.push(c)
    out

// LVNs of the previous and current period. An old LVN the current period has filled with a
// cluster is gone; overlapping LVNs merge; an HVN wins over an LVN where they overlap.
f_mergeLvn(array<Zone> prevLvn, array<Zone> curLvn, array<Zone> curCores, array<Zone> hvnZones, float unit) =>
    minW  = LVN_MIN_W * unit
    zones = array.new<Zone>()
    for z in prevLvn
        for piece in f_clip(z, curCores, minW)
            piece.tags := array.from(z.fromT)
            zones.push(piece)
    for z in curLvn
        c = z.copy()
        c.tags := array.from(z.fromT)
        zones.push(c)
    merged = array.new<Zone>()
    for z in f_sortByLo(zones)
        if merged.size() > 0 and z.lo <= merged.last().hi
            last = merged.last()
            last.hi    := math.max(last.hi, z.hi)
            last.fromT := math.min(last.fromT, z.fromT)
            for t in z.tags
                if not last.tags.includes(t)
                    last.tags.push(t)
        else
            merged.push(z)
    out = array.new<Zone>()
    for z in merged
        for piece in f_clip(z, hvnZones, minW)
            piece.count := z.tags.size()
            out.push(piece)
    out

// HVN / LVN of the current and previous week, merged. Built from confirmed bars only.
f_zonesWeek() =>
    hv = array.new<Zone>()
    lv = array.new<Zone>()
    n  = bH.size()
    if not na(wkStart)
        cs      = wkStart - bBase
        hasPrev = not na(wkPrevStart) and wkPrevStart >= bBase
        ps      = hasPrev ? wkPrevStart - bBase : cs
        unit    = hasPrev ? f_hourUnit(ps, cs) : f_hourUnit(cs, n)
        pHv = array.new<Zone>()
        pLv = array.new<Zone>()
        if hasPrev
            [h1, l1, c1] = f_nodes(ps, cs, unit, HVN_ROW_FRAC, HVN_MIN_ROWS)
            pHv := f_tag(h1, wkPrevT0)
            pLv := f_tag(l1, wkPrevT0)
        [h2, l2, c2] = f_nodes(cs, n, unit, HVN_ROW_FRAC, HVN_MIN_ROWS)
        allHv = array.copy(pHv)
        allHv.concat(f_tag(h2, wkT0))
        hv := f_mergeHvn(allHv, unit)
        lv := f_mergeLvn(pLv, f_tag(l2, wkT0), c2, hv, unit)
    [hv, lv]

// Daily HVN from the last maxSessions days plus today; daily LVN from yesterday and today.
f_zonesDay() =>
    hv = array.new<Zone>()
    lv = array.new<Zone>()
    n  = bH.size()
    nD = dayStarts.size()
    if nD > 0
        first   = math.max(0, nD - 1 - maxSessions)
        fs      = math.max(0, dayStarts.get(first) - bBase)
        curS    = math.max(0, dayStarts.get(nD - 1) - bBase)
        doneEnd = first < nD - 1 ? curS : n
        unit    = f_hourUnit(fs, doneEnd > fs ? doneEnd : n)
        hvAll   = array.new<Zone>()
        lvY     = array.new<Zone>()
        lvT     = array.new<Zone>()
        coresT  = array.new<Zone>()
        for d = first to nD - 1
            a = math.max(0, dayStarts.get(d) - bBase)
            b = d < nD - 1 ? dayStarts.get(d + 1) - bBase : n
            [h, l, c] = f_nodes(a, b, unit, HVN_DAY_ROW_FRAC, HVN_DAY_MIN_ROWS)
            hvAll.concat(f_tag(h, dayT0s.get(d)))
            if d == nD - 2
                lvY := f_tag(l, dayT0s.get(d))
            if d == nD - 1
                lvT    := f_tag(l, dayT0s.get(d))
                coresT := c
        hv := f_pickReputable(hvAll, unit)
        lv := f_mergeLvn(lvY, lvT, coresT, hv, unit)
    [hv, lv]

var array<box>   zBoxes  = array.new<box>()
var array<line>  zLines  = array.new<line>()
var array<label> zLabels = array.new<label>()

// Above the live price = sell, below = buy, price inside = gray (not tradable yet).
f_drawZone(Zone z, string kind, color buyC, color sellC, string unitName) =>
    side   = z.hi < close ? 1 : z.lo > close ? -1 : 0
    base   = side > 0 ? buyC : side < 0 ? sellC : hvnInsideColor
    fillC  = color.new(base, side != 0 ? 82 : 90)
    lineC  = color.new(base, side != 0 ? 5 : 40)
    st     = side == 0 ? line.style_dotted : kind == "LVN" ? line.style_dashed : line.style_solid
    zBoxes.push(box.new(z.fromT, z.hi, time, z.lo, xloc = xloc.bar_time, extend = extend.right, border_width = 0, border_color = TRANSPARENT, bgcolor = fillC))
    zLines.push(line.new(z.fromT, z.hi, time, z.hi, xloc = xloc.bar_time, extend = extend.right, color = lineC, style = st, width = 1))
    zLines.push(line.new(z.fromT, z.lo, time, z.lo, xloc = xloc.bar_time, extend = extend.right, color = lineC, style = st, width = 1))
    sideTxt = side > 0 ? " Buy" : side < 0 ? " Sell" : " (giá đang trong vùng)"
    suffix  = z.count > 1 ? " · " + str.tostring(z.count) + " " + unitName : ""
    txt     = kind + sideTxt + " " + str.tostring(z.lo, format.mintick) + " – " + str.tostring(z.hi, format.mintick) + suffix
    zLabels.push(label.new(time + 8 * barMs, z.hi, txt, xloc = xloc.bar_time, style = label.style_label_lower_left, color = TRANSPARENT, textcolor = lineC, size = size.small))

// =====================================================================================
//  SESSIONS  (confirmed bars only -> non-repaint)
// =====================================================================================
var array<Prof>     wkDone  = array.new<Prof>()
var array<Prof>     dyDone  = array.new<Prof>()
var array<polyline> wkPolys = array.new<polyline>()
var array<polyline> dyPolys = array.new<polyline>()
var bool wkDirty = false
var bool dyDirty = false

if barstate.isconfirmed
    aEnd = bBase + bH.size()
    if newDay or na(dyStart)
        if not na(dyStart) and showDayProfile and aEnd > dyStart
            dyDone.push(f_makeProf(dyStart - bBase, aEnd - bBase, false, dyT0, dyLastT, dyBars, showDayVA, colDayVA))
            while dyDone.size() > maxSessions
                old = dyDone.shift()
                old.del()
            dyDirty := true
        dyStart := aEnd
        dyT0    := time
        dyBars  := 0
        dayStarts.push(aEnd)
        dayT0s.push(time)
        while dayStarts.size() > maxSessions + 1
            dayStarts.shift()
            dayT0s.shift()
    if newWeek or na(wkStart)
        if not na(wkStart) and showWeekProfile and aEnd > wkStart
            wkDone.push(f_makeProf(wkStart - bBase, aEnd - bBase, false, wkT0, wkLastT, wkBars, showWeekVA, colWeekVA))
            while wkDone.size() > maxSessions
                old = wkDone.shift()
                old.del()
            wkDirty := true
        wkPrevStart := wkStart
        wkPrevT0    := wkT0
        wkStart     := aEnd
        wkT0        := time
        wkBars      := 0
    // Drop base bars no session still needs.
    keepFrom = isDay ? dayStarts.get(0) : na(wkPrevStart) ? wkStart : wkPrevStart
    if keepFrom > bBase
        cut = keepFrom - bBase
        sz  = bH.size()
        bH := array.copy(array.slice(bH, cut, sz))
        bL := array.copy(array.slice(bL, cut, sz))
        bV := array.copy(array.slice(bV, cut, sz))
        bO := array.copy(array.slice(bO, cut, sz))
        bC := array.copy(array.slice(bC, cut, sz))
        bT := array.copy(array.slice(bT, cut, sz))
        bBase := keepFrom
    for [i, h] in dH
        bH.push(h)
        bL.push(dL.get(i))
        bV.push(dV.get(i))
        bO.push(dO.get(i))
        bC.push(dC.get(i))
        bT.push(dT.get(i))
    wkBars  += 1
    dyBars  += 1
    wkLastT := time
    dyLastT := time

// Finished profiles and zones only change when a bar closes: rebuild them on the last confirmed
// history bar and on confirmed realtime bars, never per tick.
var array<Zone> hvnZ = array.new<Zone>()
var array<Zone> lvnZ = array.new<Zone>()

if barstate.isconfirmed and (barstate.islastconfirmedhistory or barstate.isrealtime)
    if wkDirty
        f_clearPolys(wkPolys)
        f_drawProfs(wkDone, wkPolys, colBuy, colSell)
        wkDirty := false
    if dyDirty
        f_clearPolys(dyPolys)
        f_drawProfs(dyDone, dyPolys, colDayBuy, colDaySell)
        dyDirty := false
    if showHVN or showLVN
        if isDay
            [h, l] = f_zonesDay()
            hvnZ := h
            lvnZ := l
        else
            [h, l] = f_zonesWeek()
            hvnZ := h
            lvnZ := l

// Developing profiles and zone colours: redrawn on the last bar, including the forming bar.
// On the first forming bar of a new session the stored data is still the previous session's.
// Visible candles' range; reading chart.*_visible_bar_time reruns the script on every scroll / zoom.
var float visHi = na
var float visLo = na
if rowNumbersOn != "Off" and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    visHi := na(visHi) ? high : math.max(visHi, high)
    visLo := na(visLo) ? low : math.min(visLo, low)

var array<polyline> livePolys = array.new<polyline>()
var array<label>    rowLabels = array.new<label>()
var Prof liveWk = na
var Prof liveDy = na

if barstate.islast
    f_clearPolys(livePolys)
    for lb in rowLabels
        label.delete(lb)
    rowLabels.clear()
    if not na(liveWk)
        liveWk.del()
    if not na(liveDy)
        liveDy.del()
    liveWk := na
    liveDy := na
    if showLive
        n = bH.size()
        if showWeekProfile and not na(wkStart)
            addW = not barstate.isconfirmed and not newWeek
            a = wkStart - bBase
            if addW or n > a
                liveWk := f_makeProf(a, n, addW, wkT0, time, wkBars + (addW ? 1 : 0), showWeekVA, colWeekVA)
                f_drawProf(liveWk, livePolys, colBuy, colSell)
                if rowNumbersOn == "Week" or rowNumbersOn == "Both"
                    f_rowNumbers(liveWk, rowLabels, visHi, visLo)
        // Day after week, so the day profile sits on top.
        if showDayProfile and not na(dyStart)
            addD = not barstate.isconfirmed and not newDay
            a = dyStart - bBase
            if addD or n > a
                liveDy := f_makeProf(a, n, addD, dyT0, time, dyBars + (addD ? 1 : 0), showDayVA, colDayVA)
                f_drawProf(liveDy, livePolys, colDayBuy, colDaySell)
                if rowNumbersOn == "Day" or rowNumbersOn == "Both"
                    f_rowNumbers(liveDy, rowLabels, visHi, visLo)

    for b in zBoxes
        box.delete(b)
    zBoxes.clear()
    for l in zLines
        line.delete(l)
    zLines.clear()
    for lb in zLabels
        label.delete(lb)
    zLabels.clear()
    unitName = isDay ? "ngày" : "tuần"
    if showHVN
        for z in hvnZ
            f_drawZone(z, "HVN", hvnBuyColor, hvnSellColor, unitName)
    if showLVN
        for z in lvnZ
            f_drawZone(z, "LVN", lvnBuyColor, lvnSellColor, unitName)

// =====================================================================================
//  ANCHORED VWAP  (from 1m bars, so the line is the same on every timeframe)
// =====================================================================================
var float sV   = 0.0
var float sPV  = 0.0
var float sP2V = 0.0
bool vwapAnc = false
if vV.size() > 0
    for [i, v] in vV
        if vNew.get(i)
            sV   := 0.0
            sPV  := 0.0
            sP2V := 0.0
            vwapAnc := true
        if not na(v) and not na(vPV.get(i)) and not na(vP2V.get(i))
            sV   += v
            sPV  += vPV.get(i)
            sP2V += vP2V.get(i)
else
    if chartAnc
        sV   := 0.0
        sPV  := 0.0
        sP2V := 0.0
        vwapAnc := true
    p = f_src()
    if not na(volume) and not na(p)
        sV   += volume
        sPV  += p * volume
        sP2V += p * p * volume
float vwapVal = sV > 0 ? sPV / sV : na
float vwapSd  = sV > 0 ? math.sqrt(math.max(0.0, sP2V / sV - vwapVal * vwapVal)) : na

hasVwapPoint = showVWAP and not na(vwapVal) and not na(vwapSd)

// VWAP and bands are polylines, not plot(): plots get selection dots on every point when the
// indicator is clicked. This plot only feeds the price-scale label.
plot(showVWAP ? vwapVal : na, "VWAP", color = colVWAP, display = display.price_scale)

vwChunkMax = 4000   // polyline cap is 10000 points; a zone polygon uses 2 x chunk points

var array<chart.point> vwM  = array.new<chart.point>()
var array<chart.point> vwU1 = array.new<chart.point>()
var array<chart.point> vwL1 = array.new<chart.point>()
var array<chart.point> vwU2 = array.new<chart.point>()
var array<chart.point> vwL2 = array.new<chart.point>()
var array<chart.point> vwU3 = array.new<chart.point>()
var array<chart.point> vwL3 = array.new<chart.point>()
var array<polyline> vwHist  = array.new<polyline>()
var array<int>      vwBatch = array.new<int>()
var array<polyline> vwLive  = array.new<polyline>()

f_resetPoints(array<chart.point> a, bool keepLast) =>
    if keepLast and a.size() > 0
        p = a.last()
        a.clear()
        a.push(p)
    else
        a.clear()

f_withPoint(array<chart.point> a, bool add, float price) =>
    c = array.copy(a)
    if add
        c.push(chart.point.from_time(time, price))
    c

// Closed polygon: outer edge left -> right, then inner edge right -> left.
f_ring(array<chart.point> outer, array<chart.point> inner) =>
    pts = array.copy(outer)
    rev = array.copy(inner)
    rev.reverse()
    pts.concat(rev)
    pts

f_zone(array<polyline> pool, array<chart.point> outer, array<chart.point> inner, color fillCol) =>
    pool.push(polyline.new(f_ring(outer, inner), curved = false, closed = true, xloc = xloc.bar_time, line_color = TRANSPARENT, fill_color = fillCol))

f_path(array<polyline> pool, array<chart.point> pts, color col, int wid) =>
    pool.push(polyline.new(pts, curved = false, closed = false, xloc = xloc.bar_time, line_color = col, fill_color = TRANSPARENT, line_width = wid))

// Zones first so lines sit on top. Each zone spans from the next enabled band inside it (or the
// VWAP) out to its own band.
f_vwapPolys(array<polyline> pool, array<chart.point> m, array<chart.point> u1, array<chart.point> l1, array<chart.point> u2, array<chart.point> l2, array<chart.point> u3, array<chart.point> l3) =>
    if m.size() > 1
        array<chart.point> inU = m
        array<chart.point> inL = m
        if showBand1
            f_zone(pool, u1, inU, bandFill1)
            f_zone(pool, l1, inL, bandFill1)
            inU := u1
            inL := l1
        if showBand2
            f_zone(pool, u2, inU, bandFill2)
            f_zone(pool, l2, inL, bandFill2)
            inU := u2
            inL := l2
        if showBand3
            f_zone(pool, u3, inU, bandFill3)
            f_zone(pool, l3, inL, bandFill3)
        if showBand1
            f_path(pool, u1, bandLine1, 1)
            f_path(pool, l1, bandLine1, 1)
        if showBand2
            f_path(pool, u2, bandLine2, 1)
            f_path(pool, l2, bandLine2, 1)
        if showBand3
            f_path(pool, u3, bandLine3, 1)
            f_path(pool, l3, bandLine3, 1)
        f_path(pool, m, colVWAP, vwapWidth)

// Collect confirmed bars; a finished period (or a full chunk) is drawn once, permanently.
if barstate.isconfirmed and showVWAP
    vwPeriodEnd = vwapAnc and vwM.size() > 0
    vwChunkFull = vwM.size() >= vwChunkMax
    if vwPeriodEnd or vwChunkFull
        n0 = vwHist.size()
        f_vwapPolys(vwHist, vwM, vwU1, vwL1, vwU2, vwL2, vwU3, vwL3)
        vwBatch.push(vwHist.size() - n0)
        while vwBatch.size() > vwapKeep
            nb = vwBatch.shift()
            if nb > 0
                for i = 1 to nb
                    polyline.delete(vwHist.shift())
        // A chunk split inside one period keeps its last point so the line stays joined.
        keepLast = not vwPeriodEnd
        f_resetPoints(vwM,  keepLast)
        f_resetPoints(vwU1, keepLast)
        f_resetPoints(vwL1, keepLast)
        f_resetPoints(vwU2, keepLast)
        f_resetPoints(vwL2, keepLast)
        f_resetPoints(vwU3, keepLast)
        f_resetPoints(vwL3, keepLast)
    if hasVwapPoint
        vwM.push(chart.point.from_time(time, vwapVal))
        vwU1.push(chart.point.from_time(time, vwapVal + bandMult1 * vwapSd))
        vwL1.push(chart.point.from_time(time, vwapVal - bandMult1 * vwapSd))
        vwU2.push(chart.point.from_time(time, vwapVal + bandMult2 * vwapSd))
        vwL2.push(chart.point.from_time(time, vwapVal - bandMult2 * vwapSd))
        vwU3.push(chart.point.from_time(time, vwapVal + bandMult3 * vwapSd))
        vwL3.push(chart.point.from_time(time, vwapVal - bandMult3 * vwapSd))

// Current period: redrawn on the last bar, including the still-forming bar.
if barstate.islast
    f_clearPolys(vwLive)
    if showVWAP
        addCur = hasVwapPoint and not barstate.isconfirmed and not vwapAnc
        f_vwapPolys(vwLive, f_withPoint(vwM, addCur, vwapVal), f_withPoint(vwU1, addCur, vwapVal + bandMult1 * vwapSd), f_withPoint(vwL1, addCur, vwapVal - bandMult1 * vwapSd), f_withPoint(vwU2, addCur, vwapVal + bandMult2 * vwapSd), f_withPoint(vwL2, addCur, vwapVal - bandMult2 * vwapSd), f_withPoint(vwU3, addCur, vwapVal + bandMult3 * vwapSd), f_withPoint(vwL3, addCur, vwapVal - bandMult3 * vwapSd))

// =====================================================================================
//  HIDE CANDLES
// =====================================================================================
barcolor(hideCandles ? TRANSPARENT : color(na))
