      <HintPath>$(HOME)/quantower-libs/System.Drawing.Common.dll</HintPath><Private>false</Private>
    </Reference>
    <Compile Include="../BenzoCore.cs" />
    <Compile Include="../BenzoZones.cs" />
    <Compile Include="../BenzoDetectors.cs" />
    <Compile Include="../BenzoSr.cs" />
    <Compile Include="../BenzoLayers.cs" />
